---
/**
 * Base layout.
 *
 * Owns the document shell, global head defaults and skip link. Page-specific
 * metadata belongs to the SEO component rendered by each page.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@/styles/global.css';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SiteSchema from '@/components/SiteSchema.astro';
import { SITE } from '@/data/site';

interface Props {
  /** Applies a tighter top padding for pages that lead with a hero. */
  bodyClass?: string;
  /**
   * When true the header floats transparently over a full-height hero and the
   * page owns the top spacing. Otherwise the fixed header is offset with padding.
   */
  heroOverlay?: boolean;
}

const { bodyClass = '', heroOverlay = false } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Marks JS as available before first paint so progressive-enhancement
      // styles (scroll reveal) never hide content from no-JS visitors.
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <meta name="data-revision" content={SITE.dataRevision} />
    <SiteSchema />
  </head>
  <body class:list={['min-h-screen flex flex-col', bodyClass]}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header overHero={heroOverlay} />
    <main id="main" class:list={['flex-1', !heroOverlay && 'pt-16 lg:pt-[4.5rem]']}>
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from 'lenis';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Smooth scrolling. Skipped entirely for reduced-motion users, who keep
      // the native instant scroll and the CSS smooth fallback.
      if (!reduceMotion) {
        const lenis = new Lenis({
          duration: 1.05,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });

        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        // Route in-page anchor clicks through Lenis so jumps are eased and the
        // sticky header offset is respected.
        document.addEventListener('click', (event) => {
          const target = event.target as HTMLElement | null;
          const link = target?.closest<HTMLAnchorElement>('a[href^="#"]');
          if (!link) return;
          const hash = link.getAttribute('href');
          if (!hash || hash.length < 2) return;
          const el = document.querySelector(hash);
          if (!el) return;
          event.preventDefault();
          lenis.scrollTo(el as HTMLElement, { offset: -88 });
          history.pushState(null, '', hash);
        });
      }

      // Scroll-reveal: adds .is-visible as elements enter the viewport. Elements
      // are fully readable without JS because the hidden state only applies to
      // the .reveal-on-scroll class under a no-preference media query.
      const revealables = document.querySelectorAll<HTMLElement>('.reveal-on-scroll');
      if (revealables.length && 'IntersectionObserver' in window && !reduceMotion) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
        );
        revealables.forEach((el) => observer.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
