---
/**
 * Inline callout used for caveats, modelled-versus-verified markers and risks.
 * Tone is semantic, not decorative: the icon and colour both change with `tone`.
 */
interface Props {
  tone?: 'note' | 'caution' | 'verified' | 'modelled';
  title?: string;
  class?: string;
}

const { tone = 'note', title, class: className = '' } = Astro.props;

const tones = {
  note: {
    wrap: 'border-line bg-paper-deep',
    title: 'text-ink-900',
    icon: 'text-ink-500',
    label: 'Note',
  },
  caution: {
    wrap: 'border-flag-100 bg-flag-50',
    title: 'text-flag-700',
    icon: 'text-flag-600',
    label: 'Read this first',
  },
  verified: {
    wrap: 'border-save-100 bg-save-50',
    title: 'text-save-700',
    icon: 'text-save-600',
    label: 'Verified data',
  },
  modelled: {
    wrap: 'border-cool-100 bg-cool-50',
    title: 'text-cool-700',
    icon: 'text-cool-600',
    label: 'Modelled estimate',
  },
} as const;

const t = tones[tone];
---

<aside class:list={['not-prose rounded-lg border p-4 sm:p-5', t.wrap, className]} role={tone === 'caution' ? 'note' : undefined}>
  <div class="flex gap-3">
    <span class:list={['mt-0.5 shrink-0', t.icon]} aria-hidden="true">
      {tone === 'verified' && (
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="1.5" />
          <path d="M5.8 9.3l2.1 2.1L12.3 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {tone === 'modelled' && (
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <rect x="2" y="3" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5" />
          <path d="M5.5 11.5l2.2-3 2.2 2.2 2.6-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {tone === 'caution' && (
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M9 2.8l6.4 11.2H2.6L9 2.8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          <path d="M9 7.4v3.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          <circle cx="9" cy="12.4" r="0.9" fill="currentColor" />
        </svg>
      )}
      {tone === 'note' && (
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="1.5" />
          <path d="M9 8v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          <circle cx="9" cy="5.6" r="0.9" fill="currentColor" />
        </svg>
      )}
    </span>
    <div class="min-w-0 text-sm leading-relaxed [&>p+p]:mt-3">
      {title && <p class:list={['mb-1.5 font-semibold', t.title]}>{title}</p>}
      <div class="text-ink-700">
        <slot />
      </div>
    </div>
  </div>
</aside>
