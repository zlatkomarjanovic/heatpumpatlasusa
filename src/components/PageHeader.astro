---
/**
 * Page header for interior pages: breadcrumbs, title, standfirst and an
 * optional key stat. Deliberately compact, no oversized empty hero.
 */
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import type { Breadcrumb } from '@/types/seo';

interface Props {
  eyebrow?: string;
  title: string;
  standfirst?: string;
  breadcrumbs?: Breadcrumb[];
  updated?: Date;
  reviewedBy?: string;
  keyStat?: { value: string; label: string; source?: string };
  /** Drop the bottom divider, e.g. when a full-bleed cover image follows. */
  flush?: boolean;
}

const { eyebrow, title, standfirst, breadcrumbs = [], updated, reviewedBy, keyStat, flush = false } = Astro.props;
---

<div class:list={['bg-white', !flush && 'border-line border-b']}>
  <div class="container-atlas pt-6 pb-9 lg:pt-8 lg:pb-12">
    {breadcrumbs.length > 1 && (
      <div class="mb-5">
        <Breadcrumbs items={breadcrumbs} />
      </div>
    )}

    <div class="grid gap-8 lg:grid-cols-[minmax(0,2.1fr)_minmax(0,1fr)] lg:items-end">
      <div>
        {eyebrow && (
          <p class="text-brand-700 mb-2.5 text-xs font-semibold tracking-wider uppercase">{eyebrow}</p>
        )}
        <h1 class="text-3xl leading-[1.15] sm:text-4xl lg:text-[2.75rem]">{title}</h1>
        {standfirst && (
          <p class="text-ink-600 mt-4 max-w-2xl text-base leading-relaxed sm:text-lg">{standfirst}</p>
        )}
        <div class="text-ink-500 mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs">
          {updated && (
            <span>
              Updated{' '}
              <time datetime={updated.toISOString()}>
                {updated.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            </span>
          )}
          {reviewedBy && <span>Reviewed by {reviewedBy}</span>}
          <a href="/methodology/" class="hover:text-brand-700 underline decoration-line-strong underline-offset-2">
            How we calculate this
          </a>
        </div>
      </div>

      {keyStat && (
        <aside class="rounded-2xl bg-paper-deep p-5 ring-1 ring-line sm:p-6">
          <p class="text-2xs font-semibold tracking-wide text-brand-700 uppercase">The short answer</p>
          <p class="text-ink-950 mt-2 font-serif text-2xl leading-snug font-medium">{keyStat.value}</p>
          <p class="text-ink-600 mt-2 text-sm leading-relaxed">{keyStat.label}</p>
          {keyStat.source && (
            <p class="text-ink-400 mt-3 text-2xs">Source: {keyStat.source}</p>
          )}
        </aside>
      )}
    </div>
  </div>
</div>
