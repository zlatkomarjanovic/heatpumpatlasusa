---
/**
 * Site-wide Organization and WebSite schema.
 *
 * Rendered once in the base layout so Organization is available as a publisher
 * reference for every page. Kept separate from the per-page SEO component so the
 * @id references resolve.
 */
import { SITE, SOCIAL_PROFILES } from '@/data/site';

const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      email: SITE.email,
      foundingDate: SITE.founded,
      areaServed: { '@type': 'Country', name: 'United States' },
      knowsAbout: [
        'heat pump cost',
        'heat pump installation cost',
        'mini split installation cost',
        'heat pump vs furnace',
        'heat pump rebates',
        'heat pump tax credit',
        'heat pump cost calculator',
        'mass save heat pump rebate',
        'efficiency maine heat pump rebate',
        'electrical panel upgrade cost',
        'heat pump water heater cost',
        'heat pump operating cost',
      ],
      publishingPrinciples: `${SITE.url}/methodology/`,
      about: { '@id': `${SITE.url}/about/` },
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email,
        contactType: 'editorial',
        availableLanguage: 'English',
      },
      sameAs: [
        ...SOCIAL_PROFILES.map((p) => p.href),
        'https://zlatkomarjanovic.wordpress.com',
        'https://www.tumblr.com/blog/view/zlajaa2000',
      ],
      image: {
        '@type': 'ImageObject',
        url: `${SITE.url}/og-default.png`,
        width: 1200,
        height: 630,
      },
      logo: {
        '@type': 'ImageObject',
        url: `${SITE.url}/logo-512.png`,
        width: 512,
        height: 512,
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      alternateName: SITE.shortName,
      description: SITE.description,
      inLanguage: 'en-US',
      publisher: { '@id': `${SITE.url}/#organization` },
      image: `${SITE.url}/og-default.png`,
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
