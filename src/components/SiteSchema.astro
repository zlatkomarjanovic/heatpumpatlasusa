---
/**
 * Site-wide Organization and WebSite schema.
 *
 * Rendered once in the base layout so Organization is available as a publisher
 * reference for every page. Kept separate from the per-page SEO component so the
 * @id references resolve.
 */
import { SITE } from '@/data/site';

const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      email: SITE.email,
      foundingDate: SITE.founded,
      areaServed: { '@type': 'Country', name: 'United States' },
      knowsAbout: [
        'Heat pump installed cost',
        'Heat pump operating cost',
        'US heat pump rebates',
        'Heating fuel economics',
      ],
      publishingPrinciples: `${SITE.url}/methodology/`,
      about: { '@id': `${SITE.url}/about/` },
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email,
        contactType: 'editorial',
        availableLanguage: 'English',
      },
      sameAs: ['https://github.com/zlatkomarjanovic/heatpumpatlasusa'],
      logo: {
        '@type': 'ImageObject',
        url: `${SITE.url}/logo.svg`,
        width: 512,
        height: 512,
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'en-US',
      publisher: { '@id': `${SITE.url}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE.url}/guides/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
