---
/**
 * Accessible FAQ using native details/summary so answers are present in the HTML
 * for crawlers and available without JavaScript. Pairs with FAQPage schema.
 */
interface Props {
  items: { question: string; answer: string }[];
  title?: string;
  id?: string;
  /** Set false when the page already emits FAQPage schema elsewhere. */
  class?: string;
}

const { items, title = 'Frequently asked questions', id = 'faq', class: className = '' } = Astro.props;
---

{items.length > 0 && (
  <section id={id} class:list={['not-prose scroll-mt-24', className]} aria-labelledby={`${id}-heading`}>
    <h2 id={`${id}-heading`} class="text-xl sm:text-2xl">{title}</h2>
    <div class="border-line divide-line mt-5 divide-y border-y">
      {items.map((item) => (
        <details class="faq-item group py-1">
          <summary
            class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-left [&::-webkit-details-marker]:hidden"
          >
            <span class="text-ink-900 text-base font-medium sm:text-lg">{item.question}</span>
            <span
              class="text-ink-400 group-hover:text-brand-600 mt-0.5 shrink-0 transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
                <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
            </span>
          </summary>
          <div class="faq-panel">
            <div class="text-ink-600 max-w-3xl pb-5 text-[0.95rem] leading-relaxed sm:text-base">
              {item.answer}
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>
)}

<script is:inline>
  // Animate FAQ answers open and closed while keeping native details semantics.
  (function () {
    if (window.__faqAnimateInit) return;
    window.__faqAnimateInit = true;
    // Reduced-motion users keep the native, instant details toggle untouched.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var items = document.querySelectorAll('details.faq-item');
    items.forEach(function (d) {
      var panel = d.querySelector('.faq-panel');
      if (!panel) return;
      if (!d.open) panel.style.height = '0px';
      var summary = d.querySelector('summary');
      if (!summary) return;
      summary.addEventListener('click', function (e) {
        e.preventDefault();
        if (d.open) {
          panel.style.height = panel.scrollHeight + 'px';
          requestAnimationFrame(function () {
            panel.style.height = '0px';
          });
          var closeEnd = function () {
            d.open = false;
            panel.removeEventListener('transitionend', closeEnd);
          };
          panel.addEventListener('transitionend', closeEnd);
        } else {
          d.open = true;
          panel.style.height = '0px';
          requestAnimationFrame(function () {
            panel.style.height = panel.scrollHeight + 'px';
          });
          var openEnd = function () {
            panel.style.height = 'auto';
            panel.removeEventListener('transitionend', openEnd);
          };
          panel.addEventListener('transitionend', openEnd);
        }
      });
    });
  })();
</script>
