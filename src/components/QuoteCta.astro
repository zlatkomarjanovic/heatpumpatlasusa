---
/**
 * Installer-routing CTA.
 *
 * The calculator already answers "what does this cost." This block asks for a
 * different thing: bids that use the same scope as the model, so a homeowner
 * can reject a padded quote. Phone stays optional. Contact details for the
 * editorial desk are not collected here.
 */
import Icon from '@/components/Icon.astro';

interface Props {
  title?: string;
  body?: string;
  /** Prefills the market line, e.g. "Boston, MA". */
  market?: string;
  /** Compact and inline are teasers. They must sit on a page that also renders `full`. */
  variant?: 'full' | 'compact' | 'inline';
  class?: string;
}

const {
  market,
  variant = 'full',
  class: className = '',
} = Astro.props;

const fullTitle =
  Astro.props.title ??
  (market
    ? `Ask ${market} installers to price this job, not a different one`
    : 'Ask installers to price this job, not a different one');

const fullBody =
  Astro.props.body ??
  'The range is already on this site, and the calculator will give you a ZIP-level number for free. What you do not have is a bid that uses the same scope. We send your ZIP and that range to installers who work the market, and we tell them to quote that job. You get the emails. You decide.';

const teaserTitle = Astro.props.title ?? 'The range is not the bid';
const teaserBody =
  Astro.props.body ??
  'The calculator already gives you the number. Use this if you want installers to quote the same job, so a $24,000 sales package is easy to reject.';

const endpoint = import.meta.env.PUBLIC_QUOTE_ENDPOINT ?? '';
const formId = 'quote';
---

{variant === 'inline' && (
  <aside class:list={['not-prose border-brand-200 bg-brand-50 rounded-lg border-l-4 p-4 sm:p-5', className]}>
    <p class="text-brand-800 text-sm font-semibold">{teaserTitle}</p>
    <p class="text-brand-800/85 mt-1.5 text-sm leading-relaxed">{teaserBody}</p>
    <div class="mt-3 flex flex-wrap gap-3">
      <a
        href="#quote"
        class="bg-brand-700 hover:bg-brand-800 inline-flex items-center gap-1.5 rounded-md px-3.5 py-2 text-sm font-semibold text-white transition-colors"
      >
        <Icon name="route" size={15} />
        Send this job to installers
      </a>
      <a
        href="/calculator/"
        class="border-brand-200 text-brand-800 hover:bg-brand-100 inline-flex items-center gap-1.5 rounded-md border bg-white px-3.5 py-2 text-sm font-semibold transition-colors"
      >
        <Icon name="calculator" size={15} />
        I still need the number
      </a>
    </div>
  </aside>
)}

{variant === 'compact' && (
  <aside class:list={['not-prose bg-ink-950 rounded-lg p-5 sm:p-6', className]}>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-base font-semibold text-white">{teaserTitle}</p>
        <p class="mt-1 max-w-xl text-sm leading-relaxed text-ink-400">{teaserBody}</p>
      </div>
      <a
        href="#quote"
        class="bg-brand-500 hover:bg-brand-600 inline-flex shrink-0 items-center justify-center gap-1.5 rounded-md px-4 py-2.5 text-sm font-semibold text-white transition-colors"
      >
        <Icon name="route" size={15} />
        Send this job to installers
      </a>
    </div>
  </aside>
)}

{variant === 'full' && (
  <section id="quote" class:list={['not-prose scroll-mt-24', className]} aria-label={fullTitle}>
    <div class="border-line shadow-card overflow-hidden rounded-lg border bg-white">
      <div class="grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
        <div class="p-6 sm:p-8">
          <h2 id={`${formId}-heading`} class="text-xl sm:text-2xl">{fullTitle}</h2>
          <p class="text-ink-600 mt-3 text-sm leading-relaxed sm:text-base">{fullBody}</p>

          <ul class="mt-5 space-y-2.5 text-sm">
            {[
              'We attach the modeled range so the bid has to price that job, not a sales package',
              'You also get a one-page brief you can hand to any contractor you found yourself',
              'Phone is optional. No account. If nobody covers your ZIP yet, you still get the brief',
            ].map((line) => (
              <li class="text-ink-700 flex gap-2.5">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="text-save-600 mt-0.5 shrink-0">
                  <path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {line}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-line bg-paper-deep border-t p-6 sm:p-8 lg:border-t-0 lg:border-l">
          <form
            method="post"
            action={endpoint || '/api/leads'}
            class="space-y-4"
            aria-label="Send this job to installers"
          >
            <input type="hidden" name="market" value={market ?? ''} />
            <input type="hidden" name="source" value={Astro.url.pathname} />
            <div>
              <label for={`${formId}-name`} class="text-ink-800 mb-1.5 block text-sm font-medium">Name</label>
              <input
                id={`${formId}-name`}
                name="name"
                type="text"
                autocomplete="name"
                required
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              />
            </div>
            <div>
              <label for={`${formId}-zip`} class="text-ink-800 mb-1.5 block text-sm font-medium">ZIP code</label>
              <input
                id={`${formId}-zip`}
                name="zip"
                type="text"
                inputmode="numeric"
                autocomplete="postal-code"
                pattern="\d{5}"
                maxlength="5"
                required
                placeholder="02134"
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              />
            </div>
            <div>
              <label for={`${formId}-email`} class="text-ink-800 mb-1.5 block text-sm font-medium">Email</label>
              <input
                id={`${formId}-email`}
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="you@example.com"
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              />
            </div>
            <div>
              <label for={`${formId}-phone`} class="text-ink-800 mb-1.5 block text-sm font-medium">
                Phone <span class="text-ink-400 font-normal">Optional</span>
              </label>
              <input
                id={`${formId}-phone`}
                name="phone"
                type="tel"
                autocomplete="tel"
                placeholder="Only if you want a call"
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              />
            </div>
            <div>
              <label for={`${formId}-notes`} class="text-ink-800 mb-1.5 block text-sm font-medium">
                What should they price? <span class="text-ink-400 font-normal">Optional</span>
              </label>
              <textarea
                id={`${formId}-notes`}
                name="notes"
                rows="3"
                placeholder="I have a $24,000 quote. Oil heat, ducts in the attic, 100 amp panel."
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full resize-y rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              ></textarea>
            </div>
            <button
              type="submit"
              class="bg-brand-700 hover:bg-brand-800 inline-flex w-full items-center justify-center gap-1.5 rounded-md px-4 py-3 text-sm font-semibold text-white transition-colors"
            >
              <Icon name="route" size={16} />
              Send this job to installers
            </button>
            <p class="text-ink-500 text-xs leading-relaxed">
              Installers pay for the introduction in markets we cover. That is how the site is funded. Read the
              <a href="/privacy/" class="text-brand-700 underline decoration-brand-200 underline-offset-2">privacy policy</a>
              and the
              <a href="/about/" class="text-brand-700 underline decoration-brand-200 underline-offset-2">money model</a>.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
)}
