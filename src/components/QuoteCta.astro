---
/**
 * Installer-routing CTA.
 *
 * The calculator already answers "what does this cost." This block asks for a
 * different thing: bids that use the same scope as the model, so a homeowner
 * can reject a padded quote. Phone stays optional. Contact details for the
 * editorial desk are not collected here.
 */
import Icon from '@/components/Icon.astro';
import { estimateHref } from '@/components/estimate-navigation';

interface Props {
  title?: string;
  body?: string;
  /** Prefills the market line, e.g. "Boston, MA". */
  market?: string;
  /** Compact and inline are teasers. They must sit on a page that also renders `full`. */
  variant?: 'full' | 'compact' | 'inline';
  class?: string;
}

const {
  market,
  variant = 'full',
  class: className = '',
} = Astro.props;

const fullTitle =
  Astro.props.title ??
  (market
    ? `Request a heat pump quote in ${market}`
    : 'Request a heat pump quote');

const fullBody =
  Astro.props.body ??
  'Tell us what you need and how to reach you. Have an estimate already? Use it to compare bids for the same job.';

const teaserTitle = Astro.props.title ?? 'Ready to get a quote?';
const teaserBody =
  Astro.props.body ??
  'Estimate your costs first, or tell us what you want an installer to price.';

const calculatorLink = estimateHref(Astro.url.pathname);
const formId = 'quote';
---

{variant === 'inline' && (
  <aside class:list={['not-prose border-brand-300 bg-brand-50 rounded-lg border-l-4 p-5 sm:p-6', className]}>
    <p class="text-ink-950 text-lg font-semibold">{teaserTitle}</p>
    <p class="text-ink-800 mt-2 text-base leading-relaxed">{teaserBody}</p>
    <div class="mt-3 flex flex-wrap gap-3">
      <a
        href="#quote"
        class="not-prose btn-primary min-h-12 px-5 py-3 text-base text-white underline decoration-white underline-offset-4"
      >
        <Icon name="route" size={15} />
        Get installer quotes
      </a>
      <a
        href={calculatorLink}
        class="not-prose btn-secondary min-h-12 px-5 py-3 text-base underline underline-offset-4"
      >
        <Icon name="calculator" size={15} />
        Find my price and savings
      </a>
    </div>
  </aside>
)}

{variant === 'compact' && (
  <aside class:list={['not-prose bg-ink-950 rounded-lg p-5 sm:p-6', className]}>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-base font-semibold text-white">{teaserTitle}</p>
        <p class="mt-1 max-w-xl text-sm leading-relaxed text-ink-400">{teaserBody}</p>
      </div>
      <a
        href="#quote"
        class="btn-primary shrink-0"
      >
        <Icon name="route" size={15} />
        Get installer quotes
      </a>
    </div>
  </aside>
)}

{variant === 'full' && (
  <section id="quote" class:list={['not-prose scroll-mt-24', className]} aria-label={fullTitle}>
    <div class="border-line shadow-card overflow-hidden rounded-lg border bg-white">
      <div class="grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
        <div class="p-6 sm:p-8">
          <h2 id={`${formId}-heading`} class="text-xl sm:text-2xl">{fullTitle}</h2>
          <p class="text-ink-600 mt-3 text-sm leading-relaxed sm:text-base">{fullBody}</p>

          <ul class="mt-5 space-y-2.5 text-sm">
            {[
              'Use the modeled range when you compare bids for the same job',
              'Include details like existing ducts, current fuel and any quotes you already received',
              'Phone is optional. No account required',
            ].map((line) => (
              <li class="text-ink-700 flex gap-2.5">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="text-save-600 mt-0.5 shrink-0">
                  <path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {line}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-line bg-paper-deep border-t p-6 sm:p-8 lg:border-t-0 lg:border-l">
          <form
            id={`${formId}-form`}
            method="post"
            action="/api/leads"
            class="space-y-4"
            aria-label="Get installer quotes"
          >
            <input type="hidden" name="market" value={market ?? ''} />
            <input type="hidden" name="source" value={Astro.url.pathname} />
            <div>
              <label for={`${formId}-name`} class="text-ink-800 mb-1.5 block text-base font-semibold">Name</label>
              <input
                id={`${formId}-name`}
                name="name"
                type="text"
                autocomplete="name"
                required
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              />
            </div>
            <div>
              <label for={`${formId}-zip`} class="text-ink-800 mb-1.5 block text-base font-semibold">ZIP code</label>
              <input
                id={`${formId}-zip`}
                name="zip"
                type="text"
                inputmode="numeric"
                autocomplete="postal-code"
                pattern="[0-9]{5}"
                maxlength="5"
                required
                placeholder="02134"
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              />
            </div>
            <div>
              <label for={`${formId}-email`} class="text-ink-800 mb-1.5 block text-base font-semibold">Email</label>
              <input
                id={`${formId}-email`}
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="you@example.com"
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              />
            </div>
            <div>
              <label for={`${formId}-phone`} class="text-ink-800 mb-1.5 block text-base font-semibold">
                Phone <span class="text-ink-400 font-normal">Optional</span>
              </label>
              <input
                id={`${formId}-phone`}
                name="phone"
                type="tel"
                autocomplete="tel"
                placeholder="Only if you want a call"
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              />
            </div>
            <div>
              <label for={`${formId}-notes`} class="text-ink-800 mb-1.5 block text-base font-semibold">
                What should they price? <span class="text-ink-400 font-normal">Optional</span>
              </label>
              <textarea
                id={`${formId}-notes`}
                name="notes"
                rows="3"
                placeholder="I have a $24,000 quote. Oil heat, ducts in the attic, 100 amp panel."
                class="border-line-strong focus:border-brand-500 focus:ring-brand-500/30 w-full resize-y rounded-md border bg-white px-3.5 py-2.5 text-base outline-none focus:ring-2"
              ></textarea>
            </div>
            <div id="quote-verification"></div>
            <p id="quote-verification-status" class="text-sm text-ink-700" role="status"></p>
            <button id="quote-retry-check" type="button" class="btn-secondary" hidden>Retry security check</button>
            <noscript><p class="text-base text-ink-800">Turn on JavaScript to complete the security check and send a quote request.</p></noscript>
            <button
              type="submit"
              disabled
              class="bg-brand-700 hover:bg-brand-800 inline-flex w-full items-center justify-center gap-1.5 rounded-md px-4 py-3 text-base font-semibold text-white transition-colors disabled:opacity-60"
            >
              <Icon name="route" size={16} />
              Get installer quotes
            </button>
            <p id={`${formId}-error`} class="hidden text-sm text-heat-700" role="alert">
              Could not send just now. Try again in a minute, or email editorial from the About page.
            </p>
            <p class="text-ink-500 text-xs leading-relaxed">
              Installers pay for the introduction in markets we cover. That is how the site is funded. Read the
              <a href="/privacy/" class="text-brand-700 underline decoration-brand-200 underline-offset-2">privacy policy</a>
              and the
              <a href="/about/" class="text-brand-700 underline decoration-brand-200 underline-offset-2">money model</a>.
            </p>
          </form>
          <p id={`${formId}-success`} class="hidden rounded-md bg-save-50 px-3 py-2 text-sm text-save-800" role="status" tabindex="-1">
            Your request was saved.
          </p>
          <script>
            import { mountQuoteVerification } from '@/components/turnstile';

            const form = document.querySelector<HTMLFormElement>('#quote-form');
            const box = document.querySelector<HTMLElement>('#quote-verification');
            const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
            const retry = document.querySelector<HTMLButtonElement>('#quote-retry-check');
            const verificationStatus = document.querySelector('#quote-verification-status');
            const success = document.querySelector<HTMLElement>('#quote-success');
            const error = document.querySelector('#quote-error');

            if (form && box && button && retry && verificationStatus) {
              let ready = false;
              let sending = false;
              const startVerification = () => {
                const verification = mountQuoteVerification(box, (status) => {
                  ready = status === 'ready';
                  button.disabled = sending || !ready;
                  retry.hidden = status !== 'error';
                  verificationStatus.textContent = status === 'error'
                    ? 'Could not complete the security check. Try it again.'
                    : status === 'checking' ? 'Checking that you are human…' : '';
                });

                retry.addEventListener('click', () => verification.reset());
                form.addEventListener('submit', async (event) => {
                  event.preventDefault();
                  if (sending || !ready) return;
                  sending = true;
                  button.disabled = true;
                  error?.classList.add('hidden');

                  try {
                    const response = await fetch('/api/leads', {
                      method: 'POST',
                      body: new FormData(form),
                      headers: { Accept: 'application/json' },
                    });
                    const result = await response.json();
                    if (!response.ok || !result.ok) {
                      if (error && result.error) error.textContent = result.error;
                      throw new Error('The quote request was not saved.');
                    }
                    verification.remove();
                    form.hidden = true;
                    if (success) {
                      success.classList.remove('hidden');
                      success.focus();
                    }
                  } catch {
                    error?.classList.remove('hidden');
                    sending = false;
                    verification.reset();
                  }
                });
              };

              if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                  if (!entries.some((entry) => entry.isIntersecting)) return;
                  observer.disconnect();
                  startVerification();
                }, { rootMargin: '200px' });
                observer.observe(form);
              } else {
                startVerification();
              }
            }
          </script>
        </div>
      </div>
    </div>
  </section>
)}
