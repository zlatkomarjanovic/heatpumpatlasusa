---
/**
 * Header with accessible desktop dropdowns and a mobile disclosure menu.
 *
 * Interactivity is CSS-first: desktop submenus open on hover and focus, and the
 * mobile menu is a checkbox-free details element so there is no client JS and no
 * hidden content for crawlers.
 */
import { PRIMARY_NAV, SITE } from '@/data/site';

interface Props {
  /** When true the header floats transparently over a dark hero until scrolled. */
  overHero?: boolean;
}

const { overHero = false } = Astro.props;

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header
  class:list={[
    'site-header fixed inset-x-0 top-0 z-50 border-b border-line bg-paper/95 backdrop-blur-sm',
    overHero && 'is-over-hero',
  ]}
>
  <div class="container-atlas">
    <div class="flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
      <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label={`${SITE.name} home`}>
        <svg
          width="30"
          height="30"
          viewBox="0 0 32 32"
          fill="none"
          aria-hidden="true"
          class="hdr-logo text-brand-700 transition-transform group-hover:-rotate-3"
        >
          <rect width="32" height="32" rx="7" fill="currentColor" />
          <path d="M9 21.5c0-4 2.6-6.2 5.5-8.2C16.8 11.8 18 10 18 7.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
          <circle cx="18" cy="7.5" r="2.6" fill="#fff" />
          <path d="M10 24.5h12" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity="0.6" />
        </svg>
        <span class="flex flex-col leading-none">
          <span class="hdr-brand text-ink-950 text-[0.95rem] font-semibold tracking-tight sm:text-base"
            >HeatPumpAtlas<span class="hdr-brand-accent text-brand-600">USA</span></span
          >
          <span class="hdr-sub text-ink-500 mt-0.5 hidden text-2xs font-medium tracking-wide uppercase sm:block"
            >Cost data &amp; switching economics</span
          >
        </span>
      </a>

      <!-- Desktop navigation -->
      <nav aria-label="Primary" class="hidden lg:block">
        <ul class="flex items-center gap-0.5">
          {PRIMARY_NAV.map((item) => (
            <li class="group relative">
              <a
                href={item.href}
                class:list={[
                  'hdr-nav-link flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium transition-colors',
                  isActive(item.href)
                    ? 'text-brand-700 bg-brand-50'
                    : 'text-ink-700 hover:text-brand-700 hover:bg-brand-50',
                ]}
                aria-haspopup={item.children ? 'true' : undefined}
              >
                {item.label}
                {item.children && (
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" class="hdr-chevron text-ink-400">
                    <path d="M1 3.5 5 7l4-3.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" />
                  </svg>
                )}
              </a>
              {item.children && (
                <div class="nav-dropdown absolute left-0 top-full z-50 w-[22rem] pt-2">
                  <div class="nav-dropdown-inner">
                    <ul class="border-line shadow-lift overflow-hidden rounded-xl border bg-white p-2">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="hover:bg-brand-50 block rounded-lg px-3.5 py-2.5 transition-colors"
                          >
                            <span class="text-ink-900 block text-sm font-semibold">{child.label}</span>
                            {child.description && (
                              <span class="text-ink-500 mt-0.5 block text-xs leading-snug">{child.description}</span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="/calculator/"
          class="hdr-cta bg-brand-700 hover:bg-brand-800 hidden items-center gap-1.5 rounded-md px-3.5 py-2 text-sm font-semibold text-white transition-colors sm:inline-flex"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="2.5" y="1.5" width="11" height="13" rx="2" stroke="currentColor" stroke-width="1.4" />
            <path d="M5.5 5h5M5.5 8h5M5.5 11h2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          See your real cost
        </a>

        <!-- Mobile menu -->
        <details class="group lg:hidden [&_summary::-webkit-details-marker]:hidden">
          <summary
            class="hdr-menu-btn border-line text-ink-700 hover:text-ink-950 hover:bg-paper-deep flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border transition-colors"
            aria-label="Open main menu"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" class="group-open:hidden">
              <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" class="hidden group-open:block">
              <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
          </summary>
          <div class="border-line fixed inset-x-0 top-16 bottom-0 z-40 overflow-y-auto border-t bg-white lg:hidden">
            <nav aria-label="Mobile" class="container-atlas py-5">
              <ul class="space-y-1">
                {PRIMARY_NAV.map((item) => (
                  <li>
                    {item.children ? (
                      <details class="border-line border-b py-1">
                        <summary class="text-ink-900 flex cursor-pointer list-none items-center justify-between py-3 text-base font-semibold">
                          {item.label}
                          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="text-ink-400">
                            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" />
                          </svg>
                        </summary>
                        <ul class="pb-2">
                          {item.children.map((child) => (
                            <li>
                              <a href={child.href} class="text-ink-700 hover:text-brand-700 block py-2.5 pl-3 text-sm">
                                {child.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ) : (
                      <a
                        href={item.href}
                        class="text-ink-900 border-line hover:text-brand-700 block border-b py-3 text-base font-semibold"
                      >
                        {item.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
              <a
                href="/calculator/"
                class="bg-brand-700 mt-5 flex items-center justify-center gap-2 rounded-md px-4 py-3 text-sm font-semibold text-white"
              >
                See your real cost
              </a>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Adaptive header: transparent over a hero at the top, solid once scrolled.
  (function () {
    var header = document.querySelector('.site-header.is-over-hero');
    if (!header) return;
    var solid = null;
    function update() {
      var y = window.scrollY || document.documentElement.scrollTop || 0;
      var next = y > 24;
      if (next !== solid) {
        solid = next;
        header.classList.toggle('is-solid', next);
      }
    }
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();
</script>
