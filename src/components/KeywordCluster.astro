---
/**
 * Exact-match internal links for the current URL.
 *
 * Search engines follow these anchors. Keep the visible text identical to the
 * target keyword, not a cute rewrite.
 */
import { relatedKeywords } from '@/data/keyword-map';

interface Props {
  path: string;
  heading?: string;
}

const { path, heading = 'Related searches on this site' } = Astro.props;
const items = relatedKeywords(path);
---

{items.length > 0 && (
  <nav class="not-prose border-line rounded-2xl border bg-paper px-5 py-5 sm:px-6" aria-label={heading}>
    <p class="text-ink-500 text-2xs font-semibold tracking-wider uppercase">{heading}</p>
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-brand-700 hover:text-brand-800 text-sm font-medium underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600"
          >
            {item.keyword}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
