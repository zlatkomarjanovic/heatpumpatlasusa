---
import { FOOTER_NAV, SITE, SOCIAL_PROFILES } from '@/data/site';
import { KEYWORD_GROUPS } from '@/data/keyword-map';

const year = new Date().getFullYear();
---

<footer class="border-line bg-ink-950 mt-20 border-t text-ink-300">
  <div class="container-atlas py-12 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,2fr)]">
      <div>
        <div class="flex items-center gap-2.5">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true" class="text-brand-500">
            <rect width="32" height="32" rx="7" fill="currentColor" />
            <path d="M9 21.5c0-4 2.6-6.2 5.5-8.2C16.8 11.8 18 10 18 7.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
            <circle cx="18" cy="7.5" r="2.6" fill="#fff" />
            <path d="M10 24.5h12" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity="0.6" />
          </svg>
          <span class="text-base font-semibold tracking-tight text-white"
            >HeatPumpAtlas<span class="text-brand-200">USA</span></span
          >
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-400">
          Independent US heat pump cost modelling. We publish our ranges, our rates and our assumptions, and we say
          when a heat pump is the wrong financial answer.
        </p>
        <dl class="mt-6 space-y-1.5 text-xs text-ink-400">
          <div class="flex gap-2">
            <dt class="font-medium text-ink-300">Data revision</dt>
            <dd>{SITE.dataRevision}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-ink-300">Last updated</dt>
            <dd>
              <time datetime={SITE.dataUpdated}
                >{new Date(SITE.dataUpdated).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time
              >
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-ink-300">Contact</dt>
            <dd>
              <a href="/about/#contact" class="hover:text-brand-200 underline decoration-ink-700 underline-offset-2">
                Editorial desk
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
        {FOOTER_NAV.map((group) => (
          <div>
            <h2 class="text-2xs font-semibold tracking-wider text-white uppercase">{group.title}</h2>
            <ul class="mt-3 space-y-2">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="text-ink-400 hover:text-brand-200 text-sm transition-colors">{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <nav aria-label="Heat pump keywords" class="border-ink-800 mt-12 border-t pt-8">
      <p class="text-2xs font-semibold tracking-wider text-white uppercase">Browse by search topic</p>
      <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {KEYWORD_GROUPS.map((group) => (
          <div>
            <p class="text-xs font-medium text-ink-200">{group.title}</p>
            <ul class="mt-2 space-y-1.5">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="text-ink-400 hover:text-brand-200 text-xs capitalize transition-colors">
                    {item.keyword}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>

    <div class="border-ink-800 mt-12 flex flex-col gap-4 border-t pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-ink-500">
        &copy; {year} {SITE.name}. Estimates are modelled, not quotes. Always verify current incentives before signing a
        contract.
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-ink-400">
        {SOCIAL_PROFILES.map((profile) => (
          <li>
            <a href={profile.href} rel="noopener me" class="hover:text-brand-200 transition-colors">{profile.label}</a>
          </li>
        ))}
        <li><a href="/methodology/" class="hover:text-brand-200 transition-colors">Methodology</a></li>
        <li><a href="/about/" class="hover:text-brand-200 transition-colors">About</a></li>
        <li><a href="/sitemap-index.xml" class="hover:text-brand-200 transition-colors">Sitemap</a></li>
        <li><a href="/rss.xml" class="hover:text-brand-200 transition-colors">RSS</a></li>
      </ul>
    </div>
  </div>
</footer>
