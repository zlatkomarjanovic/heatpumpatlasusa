---
import Calculator from '@/components/Calculator.tsx';
---
<section id="calculator" class="not-prose scroll-mt-24" aria-labelledby="page-estimate-heading" tabindex="-1">
  <div class="mb-4">
    <h2 id="page-estimate-heading" class="text-2xl text-ink-950 sm:text-3xl">Find your heat pump price and savings</h2>
    <p class="mt-2 max-w-2xl text-base leading-relaxed text-ink-700">
      Enter your ZIP code and tell us what heats your home. See what installation might cost and what you could save on heating each year.
    </p>
  </div>
  <Calculator client:visible={{ rootMargin: '250px' }} />
  <noscript>
    <p class="mt-3 text-base text-ink-700">Turn on JavaScript to run the calculator. The guide includes cost ranges you can read without it.</p>
  </noscript>
</section>
