---
/**
 * Calculator page.
 *
 * Server-renders the full cost band reference and the method summary so the page
 * has substantive content without JavaScript, then mounts the interactive island
 * on top.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEO from '@/components/SEO.astro';
import PageHeader from '@/components/PageHeader.astro';
import DataTable from '@/components/DataTable.astro';
import Callout from '@/components/Callout.astro';
import SourceList from '@/components/SourceList.astro';
import Faq from '@/components/Faq.astro';
import RelatedPages from '@/components/RelatedPages.astro';
import QuoteCta from '@/components/QuoteCta.astro';
import Calculator from '@/components/Calculator.tsx';
import { COST_BANDS, EFFICIENCY } from '@/data/costs';
import { pickSources } from '@/data/sources';
import { formatUsd } from '@/lib/calculator';

const path = '/calculator/';
const updated = new Date('2026-09-14');

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Calculator', href: path },
];

const columns = [
  { key: 'system', label: 'System' },
  { key: 'low', label: 'Low', numeric: true },
  { key: 'high', label: 'High', numeric: true },
  { key: 'ducts', label: 'Existing ducts', hideOnMobile: true },
];
const rows = [
  COST_BANDS['ducted-ashp-replacement'],
  COST_BANDS['ducted-ashp-standard'],
  COST_BANDS['ducted-ashp-cold-climate'],
  COST_BANDS['ductless-single-zone'],
  COST_BANDS['ductless-multi-zone'],
  COST_BANDS['geothermal'],
  COST_BANDS['hpwh'],
  COST_BANDS['panel-upgrade'],
].map((b) => ({
  system: b.label,
  low: formatUsd(b.low),
  high: formatUsd(b.high),
  ducts: b.assumesExistingDucts ? 'Required' : 'Not used',
}));

const citations = pickSources([
  'eiaElectricity',
  'eiaGas',
  'eiaHeatingOil',
  'noaaHdd',
  'censusFuel',
  'nrelResStock',
  'epriCalculator',
  'rewiringAmericaCosts',
]);

const faqs = [
  {
    question: 'How accurate is this calculator?',
    answer:
      'It is accurate about energy economics and approximate about contractor pricing. Electricity prices, climate and fuel comparisons come from published federal data, so those figures are reliable within a few percent. Installed cost is a modelled regional range and can be off by 30 percent in either direction, because two contractors bidding the same job routinely differ by that much. If you enter your actual annual heating spend, the operating cost estimate tightens considerably.',
  },
  {
    question: 'Why does it sometimes say a heat pump will cost me more?',
    answer:
      'Because in many states it will. A modern gas furnace burning $12 to $20 gas can beat a heat pump running on 20 to 30 cent electricity, especially in milder climates where the heat pump gets less annual runtime to amortise anything. Oil and propane are a different story, which is why the Northeast and rural markets show the strongest case. A calculator that always produces a saving is a sales tool, not a model.',
  },
  {
    question: 'Does the ZIP code leave my browser?',
    answer:
      'No. The cost model runs entirely in your browser against a bundled table of state energy and climate data. Nothing is collected or transmitted until you submit a quote request, and that request is a deliberate separate action.',
  },
  {
    question: 'Are the rebate figures live?',
    answer:
      'They are hand-verified rather than scraped. We track a short list of programs and record a status for each one. Programs marked Open are included in your after-rebate total, and paused or reserved programs are excluded and labelled. Because these programs fund out mid-year, confirm the current amount with the program before you sign anything.',
  },
  {
    question: 'What is missing from the model?',
    answer:
      'It does not know your actual utility tariff, your specific duct condition, your home air leakage measured rather than estimated, or whether your contractor is good. It also assumes the heat pump is correctly sized, which is the most common reason real-world results miss a model by a wide margin. Treat the output as a range to interrogate quotes with, not a quote.',
  },
];

const faqItems = faqs.map((f) => ({ question: f.question, answer: f.answer }));
---

<BaseLayout>
  <SEO
    title="Heat Pump Cost Calculator: Installed Cost, Running Cost and Payback"
    description="Enter your ZIP, floor area and current fuel to model installed heat pump cost, annual operating cost, open rebates, 10-year totals and payback. Uses EIA and NOAA data."
    path={path}
    type="SoftwareApplication"
    breadcrumbs={crumbs}
    updated={updated}
    faqs={faqItems}
    primaryKeyword="heat pump cost calculator"
  />

  <PageHeader
    eyebrow="Switching cost calculator"
    title="What a heat pump would cost you, and whether it pays"
    standfirst="Three short steps. You get an installed cost range, a running cost comparison against what you use today, a 10-year total, the rebates that are actually open in your state, and a payback figure."
    breadcrumbs={crumbs}
    updated={updated}
    keyStat={{ value: '3 steps', label: 'No account, nothing transmitted until you ask for quotes' }}
  />

  <div class="container-atlas py-10 lg:py-14">
    <div class="mx-auto max-w-5xl">
      <Calculator client:load />

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <Callout tone="modelled" title="What this is">
          <p>
            A deterministic cost model built on published federal energy and climate data plus regional installation
            pricing. Every assumption is listed inside your result, and the same code that runs in your browser is
            summarised below.
          </p>
        </Callout>
        <Callout tone="caution" title="What this is not">
          <p>
            Not a quote, not a site assessment and not a substitute for a load calculation. A Manual J by a competent
            contractor will always beat a model that has never seen your house.
          </p>
        </Callout>
      </div>
    </div>
  </div>

  <div class="container-atlas pb-14">
    <div class="mx-auto max-w-3xl space-y-12">
      <section id="bands" class="scroll-mt-24">
        <h2 class="text-xl sm:text-2xl">The cost bands behind the model</h2>
        <p class="text-ink-600 mt-3 leading-relaxed">
          These are the same bands the calculator scales by your region. They include equipment, standard labor and a
          permit. They exclude ductwork, electrical upgrades and anything a contractor discovers after opening a wall.
        </p>
        <DataTable
          class="mt-5"
          caption="Installed cost bands used by the calculator"
          columns={columns}
          rows={rows}
          mobileLabelKey="system"
          note="Regional factors range from 0.92 in the South to 1.20 in the West, with an additional 1.12 factor in high-cost states including California, Massachusetts, New York, Connecticut and Washington."
        />
      </section>

      <section id="method" class="scroll-mt-24">
        <h2 class="text-xl sm:text-2xl">How the calculation works</h2>
        <div class="prose-atlas mt-4">
          <p>The model runs in four stages. Each stage is a pure function with no network access.</p>
          <ol>
            <li>
              <strong>Resolve geography.</strong> Your ZIP maps to a state, which supplies the residential electricity
              price from the EIA, the natural gas price from the EIA, and population-weighted heating degree days from
              NOAA.
            </li>
            <li>
              <strong>Estimate the heating load.</strong> If you entered an annual heating spend, we back the load out of
              it using your current fuel and its assumed efficiency, which is the most accurate path. Otherwise we model
              it from floor area, degree days, envelope quality and build vintage.
            </li>
            <li>
              <strong>Apply system efficiency.</strong> A ducted heat pump is modelled at a seasonal coefficient of
              performance of {EFFICIENCY.ashpStandard}, cold-climate ducted at {EFFICIENCY.ashpColdClimate}, and
              ductless at {EFFICIENCY.ductless}, each reduced by duct losses of{' '}
              {Math.round(EFFICIENCY.ductLossDucted * 100)} percent for ducted systems and{' '}
              {Math.round(EFFICIENCY.ductLossDuctless * 100)} percent for ductless.
            </li>
            <li>
              <strong>Compare and total.</strong> We price the same delivered heat from your current system, subtract it
              from the heat pump, add only the rebates marked open, and produce a 10-year total and a simple payback.
            </li>
          </ol>
          <p>
            The full published method, including the limitations and the reasoning behind each constant, is on the{' '}
            <a href="/methodology/">methodology page</a>.
          </p>
        </div>
      </section>

      <section id="privacy" class="scroll-mt-24">
        <h2 class="text-xl sm:text-2xl">Privacy</h2>
        <p class="text-ink-600 mt-3 leading-relaxed">
          The calculator has no analytics inside it and sends nothing. It runs against a bundled data table. Nothing is
          collected unless you separately choose to submit a quote request, and that request only carries the details you
          can see on the form.
        </p>
      </section>

      <Faq items={faqItems} />
      <RelatedPages
        siblings={[
          { label: 'Heat pump cost', href: '/heat-pump-cost/', description: 'Full installed cost breakdown' },
          { label: 'Mini split cost', href: '/mini-split-cost/', description: 'Per-zone ductless pricing' },
          { label: 'Operating cost', href: '/heat-pump-operating-cost/', description: 'Annual running cost by state' },
          { label: 'Heat pump vs furnace', href: '/heat-pump-vs-furnace/', description: 'The comparison model, explained' },
        ]}
      />
      <SourceList sources={citations} updated={updated} />
      <QuoteCta />
    </div>
  </div>
</BaseLayout>
