---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEO from '@/components/SEO.astro';
import RelatedPages from '@/components/RelatedPages.astro';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Quote request sent', href: '/quote-sent/' },
];
---

<BaseLayout>
  <SEO
    title="Quote request sent"
    description="Your installer request is in. Check your inbox for the job brief and any installers we can route."
    path="/quote-sent/"
    type="WebPage"
    breadcrumbs={crumbs}
    noindex
  />

  <div class="container-atlas py-16 lg:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <div id="quote-ok">
        <p class="text-brand-700 text-xs font-semibold tracking-wider uppercase">Request received</p>
        <h1 class="mt-3 text-3xl sm:text-4xl">Your request is in</h1>
        <p class="text-ink-600 mt-4 leading-relaxed">
          Check your inbox for the job brief. If we have installers in that ZIP, they get the same scope you already
          modeled. You decide whether to reply.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/calculator/"
            class="bg-brand-700 hover:bg-brand-800 inline-flex items-center rounded-md px-5 py-3 text-sm font-semibold text-white transition-colors"
          >
            Run another ZIP
          </a>
          <a
            href="/heat-pump-cost/"
            class="border-line-strong text-ink-700 hover:bg-paper-deep inline-flex items-center rounded-md border bg-white px-5 py-3 text-sm font-semibold transition-colors"
          >
            Heat pump cost guide
          </a>
        </div>
      </div>

      <div id="quote-fail" hidden>
        <p class="text-brand-700 text-xs font-semibold tracking-wider uppercase">Try again</p>
        <h1 class="mt-3 text-3xl sm:text-4xl">That request did not go through</h1>
        <p class="text-ink-600 mt-4 leading-relaxed">
          Reload the page you came from and send the form again. If it still fails, email editorial from the About page.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/#quote"
            class="bg-brand-700 hover:bg-brand-800 inline-flex items-center rounded-md px-5 py-3 text-sm font-semibold text-white transition-colors"
          >
            Back to the form
          </a>
          <a
            href="/about/#contact"
            class="border-line-strong text-ink-700 hover:bg-paper-deep inline-flex items-center rounded-md border bg-white px-5 py-3 text-sm font-semibold transition-colors"
          >
            Contact editorial
          </a>
        </div>
      </div>
    </div>

    <div class="mx-auto mt-16 max-w-3xl">
      <RelatedPages
        siblings={[
          { label: 'Calculator', href: '/calculator/', description: 'ZIP-level install and operating cost' },
          { label: 'Heat pump cost', href: '/heat-pump-cost/', description: 'Installed cost bands' },
          { label: 'Rebates', href: '/rebates/', description: 'Which programs are open' },
          { label: 'About', href: '/about/', description: 'Who we are and how to reach us' },
        ]}
      />
    </div>
  </div>
</BaseLayout>

<script is:inline>
  if (new URLSearchParams(window.location.search).get('error') === '1') {
    var ok = document.getElementById('quote-ok');
    var fail = document.getElementById('quote-fail');
    if (ok) ok.hidden = true;
    if (fail) fail.hidden = false;
    document.title = 'Could not send that request | HeatPumpAtlasUSA';
  }
</script>
