---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEO from '@/components/SEO.astro';
import PageHeader from '@/components/PageHeader.astro';
import Callout from '@/components/Callout.astro';
import RelatedPages from '@/components/RelatedPages.astro';
import { SITE } from '@/data/site';

const path = '/about/';
const updated = new Date('2026-11-17');

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: path },
];
---

<BaseLayout>
  <SEO
    title="About Heat Pump Atlas USA and the Data Behind It"
    description="Who runs this site, how we make money, and why we publish the cases where a heat pump is the wrong financial answer."
    path={path}
    type="AboutPage"
    breadcrumbs={crumbs}
    updated={updated}
    primaryKeyword="about heatpumpatlasusa"
  />

  <PageHeader
    eyebrow="About"
    title="Who runs Heat Pump Atlas USA"
    standfirst="Meet the author and see where the figures in your heat pump estimate come from."
    breadcrumbs={crumbs}
    updated={updated}
    quoteCta={false}
  />

  <div class="container-atlas py-10 lg:py-14">
    <div class="mx-auto max-w-3xl space-y-12">
      <div class="prose-atlas">
        <h2 id="zlatko-marjanovic">Meet Zlatko Marjanović</h2>
        <p>
          Zlatko publishes HeatPumpAtlasUSA and writes the homeowner guides. The guides show how the site estimates
          installation cost, running cost and potential savings so you can check the assumptions before you talk to a contractor.
        </p>

        <h2>Where the numbers come from</h2>
        <p>
          We use published energy prices from the
          <a href="https://www.eia.gov/">US Energy Information Administration</a>, climate data from
          <a href="https://www.noaa.gov/">NOAA</a> and housing data from the
          <a href="https://www.census.gov/">US Census Bureau</a>. Each rebate guide links to its program administrator.
          Check the <a href="/methodology/">methodology and source dates</a> for the inputs behind a specific estimate.
          Equipment images are illustrations.
        </p>

        <h2>What an estimate can tell you</h2>
        <p>
          Start with <a href="/calculator/">your heat pump price and running costs</a>. The estimate can help you decide
          what to ask an installer and compare the same work across quotes. The actual price depends on your home, the
          equipment, the contractor and which rebates you qualify for.
        </p>

        <h2>Quote requests and corrections</h2>
        <p>
          You can use the calculator without sharing your contact details. If you choose to submit a quote request,
          the site stores the details shown on the form. See the <a href="/privacy/">privacy policy</a> for how we handle
          requests. Use the contact below to report an outdated rebate, a source we missed, or an error in the model.
        </p>
      </div>

      <Callout tone="note" title="Get in touch">
        <p id="contact">
          Corrections, data questions, and installer partnership enquiries go to the editorial desk. Use the button
          below. If you are a contractor and want to be considered for a market, tell us which ZIP codes you cover and
          how you handle heat pump sizing.
        </p>
        <p class="mt-3">
          <a
            href="/about/#contact"
            data-contact
            data-user="editor"
            data-domain={SITE.domain}
            class="text-brand-700 underline decoration-brand-200 underline-offset-2"
          >
            Email editorial
          </a>
        </p>
        <script>
          const link = document.querySelector<HTMLAnchorElement>('a[data-contact]');
          if (link?.dataset.user && link.dataset.domain) {
            link.href = `mailto:${link.dataset.user}@${link.dataset.domain}`;
          }
        </script>
      </Callout>

      <RelatedPages
        siblings={[
          { label: 'Methodology', href: '/methodology/', description: 'How every number is produced' },
          { label: 'Calculator', href: '/calculator/', description: 'The model, running' },
          { label: 'Markets', href: '/markets/', description: 'Where switching pays off' },
          { label: 'Rebates', href: '/rebates/', description: 'Program status' },
        ]}
      />
    </div>
  </div>
</BaseLayout>
