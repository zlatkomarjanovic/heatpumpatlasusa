---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEO from '@/components/SEO.astro';
import Section from '@/components/Section.astro';
import DataTable from '@/components/DataTable.astro';
import MarketCard from '@/components/MarketCard.astro';
import QuoteCta from '@/components/QuoteCta.astro';
import Icon from '@/components/Icon.astro';
import Calculator from '@/components/Calculator.tsx';
import { COST_BANDS } from '@/data/costs';
import { STATES, STATE_BY_CODE, type StateRecord } from '@/data/states';
import { formatUsd } from '@/lib/calculator';
import Faq from '@/components/Faq.astro';
import KeywordCluster from '@/components/KeywordCluster.astro';

import heroBg from '@/assets/images/outdoor-heat-pump-yard.jpg';
import condenser from '@/assets/images/heat-pump-outdoor-condenser.jpg';
import miniSplit from '@/assets/images/mini-split-living-room.jpg';
import coldClimate from '@/assets/images/cold-climate-heat-pump-snow.jpg';
import { guideCover } from '@/data/guide-images';

const path = '/';
const updated = new Date('2026-09-14');

/** Headline cost table straight from the shared cost bands. */
const costColumns = [
  { key: 'system', label: 'System' },
  { key: 'low', label: 'Low', numeric: true },
  { key: 'high', label: 'High', numeric: true },
  { key: 'ducts', label: 'Existing ducts', hideOnMobile: true },
];

const costRows = [
  COST_BANDS['ducted-ashp-standard'],
  COST_BANDS['ducted-ashp-replacement'],
  COST_BANDS['ducted-ashp-cold-climate'],
  COST_BANDS['ductless-single-zone'],
  COST_BANDS['ductless-multi-zone'],
  COST_BANDS['hpwh'],
].map((band) => ({
  system: band.label,
  low: formatUsd(band.low),
  high: formatUsd(band.high),
  ducts: band.assumesExistingDucts ? 'Required' : 'Not used',
}));

/** States where switching economics and incentive money line up best. */
const PRIORITY_STATE_CODES = ['ME', 'MA', 'VT', 'NY', 'CT', 'RI', 'NH', 'CO', 'WA', 'OR', 'MN', 'CA'];
const priorityStates = PRIORITY_STATE_CODES.map((code) => STATE_BY_CODE[code]).filter(Boolean) as StateRecord[];

/** Rank states by a simple switching-pressure index for the reference table. */
function pressureIndex(s: StateRecord): number {
  const oil = s.fuelOilShare * 100;
  const hdd = s.heatingDegreeDays / 100;
  const rate = s.electricityCentsPerKwh;
  return Math.round(oil * 1.6 + hdd * 0.9 + rate * 0.6);
}

const rankedStates = [...STATES].sort((a, b) => pressureIndex(b) - pressureIndex(a));
const stateColumns = [
  { key: 'state', label: 'State' },
  { key: 'electricity', label: 'Electricity', numeric: true },
  { key: 'hdd', label: 'Heating demand', numeric: true },
  { key: 'oil', label: 'Oil heat share', numeric: true },
  { key: 'program', label: 'Rebate status' },
];
const stateRows = rankedStates.slice(0, 12).map((s) => ({
  state: s.name,
  electricity: `${s.electricityCentsPerKwh.toFixed(1)}¢`,
  hdd: s.heatingDegreeDays.toLocaleString(),
  oil: `${Math.round(s.fuelOilShare * 100)}%`,
  program:
    s.homeEnergyRebateStatus === 'launched'
      ? 'Live'
      : s.homeEnergyRebateStatus === 'enrolling'
        ? 'Enrolling'
        : s.homeEnergyRebateStatus === 'reserved'
          ? 'Reserved'
          : 'Not launched',
}));

const marketCards = [
  { name: 'Boston, MA', href: '/markets/boston-ma/', code: 'MA', summary: 'Oil and gas mix, a mature mass-market rebate, and the highest contractor density in New England.' },
  { name: 'Portland, ME', href: '/markets/portland-me/', code: 'ME', summary: 'The strongest oil-to-heat-pump case in the country on fuel economics alone.' },
  { name: 'Denver, CO', href: '/markets/denver-co/', code: 'CO', summary: 'Cold-climate equipment demand with a state credit and a utility rebate that stack.' },
  { name: 'Seattle, WA', href: '/markets/seattle-wa/', code: 'WA', summary: 'Cheap hydro power, mild winters, and a state program for income-qualified households.' },
];

/** Easy branded and question queries a new domain can actually compete for. */
const easyWins = [
  { href: '/rebates/mass-save/', title: 'Mass Save heat pump rebate', body: 'Up to $10,000 for a whole-home Massachusetts project. Reserve the rebate before anyone starts work.', meta: 'Massachusetts program', icon: 'gift' },
  { href: '/rebates/efficiency-maine/', title: 'Efficiency Maine heat pump rebate', body: 'Up to $9,000 lifetime for qualifying Maine homes. Oil-to-heat-pump is the strongest case in the country.', meta: 'Maine program', icon: 'gift' },
  { href: '/calculator/', title: 'Heat pump cost calculator', body: 'ZIP-level install cost, operating cost, only open rebates, and the cases where a furnace still wins.', meta: 'Free, no account', icon: 'calculator' },
  { href: '/electrical-panel-upgrade-cost/', title: 'Electrical panel upgrade cost', body: '$1,400 to $5,500 for a typical 200 amp panel. A heat pump does not always need one.', meta: 'Often avoidable', icon: 'bolt' },
  { href: '/guides/what-size-heat-pump-do-i-need/', title: 'What size heat pump do I need?', body: 'Manual J, not a square-foot rule. Oversizing is the more common and more expensive mistake.', meta: 'Sizing guide', icon: 'scale' },
  { href: '/guides/do-heat-pumps-work-in-cold-weather/', title: 'Do heat pumps work in cold weather?', body: 'Yes. Cold-climate units keep heating below 0 F. The real question is running cost on the worst nights.', meta: 'Cold climate', icon: 'snowflake' },
  { href: '/rebates/nys-clean-heat/', title: 'NYSERDA heat pump rebate', body: 'NYS Clean Heat plus New York HEAR. Amounts vary by utility territory and contractor.', meta: 'New York program', icon: 'gift' },
  { href: '/guides/do-i-need-a-panel-upgrade-for-a-heat-pump/', title: 'Do I need a panel upgrade for a heat pump?', body: 'A load calculation decides it. A 100 amp service is enough more often than sales calls admit.', meta: 'Yes or no', icon: 'bolt' },
];

/** Primary content hubs, each mapped to measured US search demand. */
const hubs = [
  { href: '/heat-pump-cost/', title: 'Heat pump cost', body: 'Installed cost to install a heat pump for ducted, cold-climate, ductless and geothermal systems, with what pushes each project above the band.', meta: '22,200 monthly US searches', icon: 'dollar' },
  { href: '/mini-split-cost/', title: 'Mini split installation cost', body: 'Ductless mini split cost per zone, and why two quotes for the same three rooms can differ by $6,000.', meta: '12,100 monthly US searches', icon: 'split' },
  { href: '/heat-pump-vs-furnace/', title: 'Heat pump vs furnace', body: 'Heat pump vs gas furnace modelled ZIP by ZIP, including the states where the furnace actually wins on running cost.', meta: '8,200 combined searches', icon: 'flame' },
  { href: '/heat-pump-vs-oil/', title: 'Heat pump vs oil', body: 'Northeast oil-to-heat-pump conversion economics, where the operating cost case is strongest in the country.', meta: 'Highest switching pressure', icon: 'droplet' },
  { href: '/heat-pump-operating-cost/', title: 'Heat pump operating cost', body: 'Heat pump operating cost per year by state electricity price, climate and the fuel you burn today.', meta: 'Rates from EIA', icon: 'bolt' },
  { href: '/rebates/', title: 'Heat pump rebates', body: 'Which heat pump rebates are actually open right now, and which ones have quietly run out of money.', meta: 'Verified program by program', icon: 'gift' },
];

const steps = [
  { n: '01', title: 'Resolve your ZIP', body: 'Your ZIP maps to a state, which sets the residential electricity price from the EIA and population-weighted heating degree days from NOAA.' },
  { n: '02', title: 'Estimate the heating load', body: 'From floor area, climate, insulation and build vintage, or backed straight out of the annual heating spend you enter.' },
  { n: '03', title: 'Compare and total', body: 'We price the same delivered heat from your current fuel, add only the rebates marked open, and produce a 10-year total and payback.' },
];

/** Head-to-head comparisons surfaced on the homepage and the /compare/ hub. */
const comparisons = [
  { href: '/heat-pump-vs-furnace/', title: 'Heat pump vs gas furnace', body: 'Where cheap gas still wins, and where the heat pump pulls ahead.' },
  { href: '/heat-pump-vs-oil/', title: 'Heat pump vs oil', body: 'The strongest running-cost case in the country, in the oil-heated Northeast.' },
  { href: '/guides/heat-pump-vs-electric-baseboard/', title: 'Heat pump vs electric baseboard', body: 'Cutting a resistance-heating bill by two thirds, roughly.' },
  { href: '/guides/ducted-vs-ductless-heat-pump/', title: 'Ducted vs ductless', body: 'Which layout your house wants, and what each one costs.' },
  { href: '/guides/air-source-vs-geothermal-heat-pump/', title: 'Air source vs geothermal', body: 'When the ground loop earns its large upfront premium.' },
  { href: '/guides/dual-fuel-heat-pumps/', title: 'Dual fuel vs heat pump only', body: 'Keeping the furnace as backup, and when that pays.' },
];

const dataSources = [
  { label: 'EIA energy prices', href: 'https://www.eia.gov/electricity/monthly/' },
  { label: 'NOAA climate', href: 'https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/cdus/degree_days/' },
  { label: 'US Census housing', href: 'https://data.census.gov/table?q=B25040' },
  { label: 'NREL ResStock', href: 'https://resstock.nrel.gov/' },
  { label: 'ENERGY STAR', href: 'https://www.energystar.gov/products/heating_cooling/heat_pumps_air_source' },
];

const guides = (await getCollection('guides'))
  .filter((g) => !g.data.draft)
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 6);

const shortDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const homeFaqs = [
  {
    question: 'How much does a heat pump cost in the US?',
    answer:
      'A typical ducted air source heat pump costs $9,500 to $22,000 installed in 2026 before incentives. A like-for-like replacement that reuses ducts and line sets often lands between $7,000 and $16,000. Ductless mini split installation cost is $2,800 to $8,500 for one zone.',
  },
  {
    question: 'What is heat pump installation cost versus operating cost?',
    answer:
      'Installation cost is the contractor invoice. Operating cost is what you pay each year to run it. The heat pump cost calculator models both, then subtracts only rebates that are actually open, and compares the 10-year total to your current fuel.',
  },
  {
    question: 'Are heat pump rebates still available in 2026?',
    answer:
      'The federal 25C heat pump tax credit ended for equipment installed after 2025. State and utility heat pump rebates are still open in several markets, including the Mass Save heat pump rebate, the Efficiency Maine heat pump rebate, the NYSERDA heat pump rebate and Efficiency Vermont. We only count a program if we have verified it is accepting applications.',
  },
  {
    question: 'How much is the Mass Save heat pump rebate?',
    answer:
      'Whole-home Massachusetts projects can receive up to about $10,000. Partial-home projects are lower, generally $500 to $2,500, with a $500 sizing bonus in some cases. You usually need a reservation before installation. Read the Mass Save heat pump rebate page before you sign.',
  },
  {
    question: 'Do I need a panel upgrade for a heat pump?',
    answer:
      'Not always. A load calculation against your service and appliances decides it. A typical 200 amp electrical panel upgrade cost is $1,400 to $5,500 if you do need one. A single-zone mini split on a 200 amp panel with spare capacity usually fits without the upgrade.',
  },
  {
    question: 'Is a heat pump cheaper than a furnace?',
    answer:
      'On running cost, a heat pump beats oil, propane and electric resistance almost everywhere. Against a gas furnace it depends on your electricity-to-gas price ratio. Our heat pump vs furnace model has the heat pump winning in 27 of 51 states.',
  },
];
---

<BaseLayout heroOverlay>
  <SEO
    title="Heat Pump Cost 2026: Prices, Rebates"
    description="Heat pump cost in the US is $9,500 to $22,000 installed. Free calculator for installation cost, rebates, and payback by ZIP."
    path={path}
    type="WebPage"
    updated={updated}
    primaryKeyword="heat pump cost"
    isHub
    faqs={homeFaqs}
    itemList={{
      name: 'Heat pump cost, rebate and calculator pages',
      items: [...easyWins.slice(0, 6), ...hubs].map((h) => ({ name: h.title, url: h.href })),
    }}
  />

  <!-- Hero: headline left, the real switching calculator right, over a photo -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <Image
        src={heroBg}
        alt="Air source heat pump outdoor unit installed beside a home"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={64}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-ink-950/95 via-ink-950/88 to-brand-900/82"></div>
    </div>

    <div class="container-atlas">
      <div
        class="grid gap-10 pt-24 pb-14 lg:min-h-svh lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:items-center lg:gap-14 lg:pt-28 lg:pb-16"
      >
        <div class="min-w-0 w-full text-white lg:max-w-[36rem] lg:justify-self-start xl:max-w-[38rem]">
          <p class="hero-eyebrow mb-5">
            <span class="hero-eyebrow-dot" aria-hidden="true"></span>
            Independent US heat pump cost data
          </p>
          <h1 class="text-[2.1rem] leading-[1.08] text-white sm:text-[2.9rem] lg:text-[3.35rem]">
            <span class="hero-headline-accent">Heat pump cost</span> in the US, and whether switching pays off where you live.
          </h1>
          <p class="mt-5 text-base leading-relaxed text-white/75 sm:text-lg" data-speakable>
            Heat pump cost for a typical ducted system is $9,500 to $22,000 installed. This calculator models heat pump
            installation cost, operating cost, and the heat pump rebates that are actually open in your state, including
            the cases where a gas furnace still wins. Run it on the right.
          </p>

          <div class="mt-9 flex flex-col gap-4">
            <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div class="hero-glass-stat">
                <dt class="text-2xs font-medium tracking-wide text-white/60 uppercase">Ducted system</dt>
                <dd class="mt-1.5 font-serif text-lg font-medium text-white sm:text-xl">{formatUsd(9500, { compact: true })}&ndash;{formatUsd(22000, { compact: true })}</dd>
              </div>
              <div class="hero-glass-stat">
                <dt class="text-2xs font-medium tracking-wide text-white/60 uppercase">Mini split, 1 zone</dt>
                <dd class="mt-1.5 font-serif text-lg font-medium text-white sm:text-xl">{formatUsd(2800, { compact: true })}&ndash;{formatUsd(8500, { compact: true })}</dd>
              </div>
              <div class="hero-glass-stat">
                <dt class="text-2xs font-medium tracking-wide text-white/60 uppercase">US power price</dt>
                <dd class="mt-1.5 font-serif text-lg font-medium text-white sm:text-xl">18.34&cent;/kWh</dd>
              </div>
            </dl>

            <div class="hero-trust-band text-sm">
            <span class="inline-flex items-center gap-2 font-semibold text-white">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 text-save-400">
                <path d="M8 1.5 2.5 4v4c0 3.1 2.3 5.9 5.5 6.5 3.2-.6 5.5-3.4 5.5-6.5V4L8 1.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                <path d="M5.5 8.2 7.2 10 10.5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              No account needed
            </span>
            <span class="hero-trust-divider" aria-hidden="true"></span>
            <span class="text-white/80 leading-snug">
              Your inputs stay in the browser. Email is only asked if you want the estimate sent to you.
            </span>
            </div>
          </div>
        </div>

        <div class="min-w-0 w-full lg:justify-self-stretch">
          <Calculator client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- Data trust strip, borderless -->
  <section class="bg-white">
    <div class="container-atlas py-7">
      <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-center sm:gap-7">
        <p class="text-2xs font-semibold tracking-wider text-ink-500 uppercase">Every number traces to public data</p>
        <ul class="flex flex-wrap justify-center gap-2.5">
          {dataSources.map((source) => (
            <li>
              <a
                href={source.href}
                rel="noopener"
                class="rounded-full bg-paper px-3.5 py-1.5 text-xs font-medium text-ink-700 ring-1 ring-line transition-colors hover:bg-brand-50 hover:text-brand-800 hover:ring-brand-300"
              >
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="container-atlas space-y-24 py-20 lg:space-y-32 lg:py-28">
    <!-- Easy-win answers a new site can actually rank for -->
    <Section
      id="start-here"
      title="Start with the question you already have"
      lede="These are the branded rebates, the calculator, and the yes-or-no questions people type. If you already know what you need, skip the national ranges."
      class="reveal-on-scroll"
    >
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {easyWins.map((item) => (
          <li>
            <a
              href={item.href}
              class="group flex h-full flex-col rounded-2xl bg-white p-6 shadow-card ring-1 ring-line transition-shadow hover:shadow-lift"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-brand-100 transition group-hover:bg-brand-700 group-hover:text-white">
                <Icon name={item.icon} size={20} />
              </span>
              <h3 class="mt-4 text-base font-semibold text-ink-950 group-hover:text-brand-700">{item.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{item.body}</p>
              <p class="mt-4 text-2xs font-medium text-ink-400">{item.meta}</p>
            </a>
          </li>
        ))}
      </ul>
    </Section>

    <!-- Cost bands + image -->
    <Section
      id="costs"
      title="Heat pump installation cost, before incentives"
      lede="These bands cover equipment, standard labor and a permit for a typical 1,800 to 2,200 square foot home. They deliberately overlap, because a quote depends on your ducts, your panel and your contractor's week."
      class="reveal-on-scroll"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-start lg:gap-12">
        <div>
          <DataTable
            caption="US installed heat pump and mini split cost ranges, 2026"
            columns={costColumns}
            rows={costRows}
            mobileLabelKey="system"
            note="Ranges are modelled from published 2026 contractor and consumer pricing plus regional labor factors. They are not quotes. Add $1,400 to $5,500 if the project needs a 200 amp panel upgrade."
          />
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
            <a href="/heat-pump-cost/" class="text-brand-700 text-sm font-semibold underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">
              Full heat pump cost breakdown
            </a>
            <a href="/mini-split-cost/" class="text-brand-700 text-sm font-semibold underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">
              Mini split cost by zone
            </a>
            <a href="/electrical-panel-upgrade-cost/" class="text-brand-700 text-sm font-semibold underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">
              Panel upgrade cost
            </a>
          </div>
        </div>
        <figure class="overflow-hidden rounded-2xl bg-white shadow-card ring-1 ring-line">
          <Image
            src={condenser}
            alt="Residential heat pump outdoor condenser unit, the equipment priced in the cost bands table"
            widths={[420, 640, 840]}
            sizes="(min-width: 1024px) 30vw, 100vw"
            format="webp"
            quality={70}
            loading="lazy"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="px-4 py-3 text-xs text-ink-500">
            A typical outdoor unit for a ducted air source heat pump. Photo: Wikimedia Commons.
          </figcaption>
        </figure>
      </div>
    </Section>

    <!-- How the model works -->
    <Section
      id="how-it-works"
      title="Heat pump cost calculator, step by step"
      lede="A deterministic model, not a lead funnel. The same code that runs in your browser is documented in full, so you can check every number instead of trusting it."
      class="reveal-on-scroll"
    >
      <ol class="grid gap-5 md:grid-cols-3">
        {steps.map((step) => (
          <li class="flex h-full flex-col rounded-2xl bg-white p-6 shadow-card ring-1 ring-line">
            <span class="font-serif text-2xl font-medium text-brand-600">{step.n}</span>
            <h3 class="mt-3 text-base font-semibold text-ink-950">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{step.body}</p>
          </li>
        ))}
      </ol>
      <p class="mt-5 text-sm text-ink-500">
        Read the full method, assumptions and limitations on the
        <a href="/methodology/" class="text-brand-700 underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">methodology page</a>.
      </p>
    </Section>

    <!-- Feature band: ductless mini splits -->
    <section class="reveal-on-scroll overflow-hidden rounded-3xl bg-white shadow-card ring-1 ring-line">
      <div class="grid gap-0 lg:grid-cols-2">
        <div class="order-2 flex flex-col justify-center p-8 sm:p-10 lg:order-1 lg:p-12">
          <p class="text-2xs font-semibold tracking-wider text-brand-700 uppercase">Ductless mini splits</p>
          <h2 class="mt-3 text-2xl sm:text-3xl">Mini split cost when you have no ducts</h2>
          <p class="mt-4 leading-relaxed text-ink-600">
            A single-zone ductless mini split heats and cools one room from roughly $2,800 to $8,500 installed. Multi-zone
            systems scale by the number of indoor heads, which is where quotes diverge most. We price it per zone so you
            can sanity-check a bid instead of guessing.
          </p>
          <div class="mt-6">
            <a href="/mini-split-cost/" class="inline-flex items-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-800">
              Mini split cost by zone
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
        <div class="relative order-1 min-h-[15rem] lg:order-2">
          <Image
            src={miniSplit}
            alt="Ductless mini split indoor wall head mounted high on a room wall"
            widths={[560, 840, 1120]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            format="webp"
            quality={70}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Hubs -->
    <Section
      id="guides"
      title="Heat pump cost, rebates and comparisons"
      lede="Each hub is built around a search demand we measured, from heat pump cost to mini split cost to heat pump vs furnace, and each one links back to the calculator so a national range becomes a local number."
      class="reveal-on-scroll"
    >
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {hubs.map((hub) => (
          <li>
            <a
              href={hub.href}
              class="group flex h-full flex-col rounded-2xl bg-white p-6 shadow-card ring-1 ring-line transition-shadow hover:shadow-lift"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-brand-100 transition group-hover:bg-brand-700 group-hover:text-white">
                <Icon name={hub.icon} size={20} />
              </span>
              <h3 class="mt-4 text-base font-semibold text-ink-950 group-hover:text-brand-700">{hub.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{hub.body}</p>
              <p class="mt-4 text-2xs font-medium text-ink-400">{hub.meta}</p>
            </a>
          </li>
        ))}
      </ul>
    </Section>

    <!-- Cold climate comparison band with image -->
    <section class="reveal-on-scroll overflow-hidden rounded-3xl bg-ink-950">
      <div class="grid gap-0 lg:grid-cols-2">
        <div class="p-8 sm:p-10 lg:p-12">
          <p class="text-xs font-semibold tracking-wider text-brand-200 uppercase">Cold climate heat pumps</p>
          <h2 class="mt-3 text-2xl text-white sm:text-3xl">Do heat pumps work in cold weather? Yes. The question is running cost.</h2>
          <p class="mt-4 leading-relaxed text-white/70">
            Modern cold-climate heat pumps hold capacity into the low teens Fahrenheit and below. The real decision is
            economic: against cheap natural gas the furnace can still win, while against oil and propane the heat pump
            usually wins outright. We model both instead of assuming one answer.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/heat-pump-vs-furnace/" class="rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-ink-900 transition hover:bg-paper">
              Heat pump vs furnace
            </a>
            <a href="/guides/do-heat-pumps-work-in-cold-weather/" class="rounded-lg px-4 py-2.5 text-sm font-semibold text-white ring-1 ring-white/25 transition hover:bg-white/10">
              Cold weather guide
            </a>
          </div>
        </div>
        <div class="relative min-h-[16rem]">
          <Image
            src={coldClimate}
            alt="Cold climate heat pump outdoor unit running in snowy winter conditions"
            widths={[560, 840, 1120]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            format="webp"
            quality={70}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Compare -->
    <Section
      id="compare"
      title="Heat pump vs furnace, oil and more"
      lede="Six head-to-head breakdowns, each one modelled rather than assumed, including the cases where staying put is the cheaper answer."
      class="reveal-on-scroll"
    >
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {comparisons.map((item) => (
          <li>
            <a
              href={item.href}
              class="group flex h-full items-start gap-3 rounded-2xl bg-white p-5 shadow-card ring-1 ring-line transition-shadow hover:shadow-lift"
            >
              <span class="mt-0.5 shrink-0 text-brand-500" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M6.5 3.5v11M11.5 3.5v11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  <path d="M3.5 7h6M8.5 11h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </span>
              <span>
                <span class="block text-sm font-semibold text-ink-950 group-hover:text-brand-700">{item.title}</span>
                <span class="mt-1 block text-sm leading-relaxed text-ink-600">{item.body}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-5">
        <a href="/compare/" class="text-brand-700 text-sm font-semibold underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">
          See all comparisons
        </a>
      </div>
    </Section>

    <!-- States -->
    <Section
      id="states"
      title="Heat pump cost by state"
      lede="Ranked by a blend of cold-weather heating load, how much of the state still burns oil, and what electricity costs. These are the states where a heat pump project is most likely to be worth modelling."
      class="reveal-on-scroll"
    >
      <DataTable
        caption="Highest switching-pressure states, ranked"
        columns={stateColumns}
        rows={stateRows}
        mobileLabelKey="state"
        note="Electricity: EIA residential average, June 2026. Heating demand: NOAA population-weighted heating degree days, July 2025 to June 2026. Oil share: Census ACS table B25040. Ranking is our own index and is a prioritisation tool, not a measurement."
      />
      <div class="mt-5">
        <a href="/markets/" class="text-brand-700 text-sm font-semibold underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">
          See market-by-market analysis
        </a>
      </div>
    </Section>

    <!-- Guides teaser -->
    {guides.length > 0 && (
      <Section
        id="guide-library"
        title="Heat pump guides: worth it, sizing and bills"
        lede="Long-form, sourced and updated. These are the plain-English answers people search for before they ever ask a contractor."
        class="reveal-on-scroll"
      >
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {guides.map((guide) => (
            <li>
              <a
                href={`/guides/${guide.id}/`}
                class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-card ring-1 ring-line transition-shadow hover:shadow-lift"
              >
                <Image
                  src={guideCover(guide.id).image}
                  alt={guideCover(guide.id).alt}
                  widths={[400, 640]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                  format="webp"
                  quality={68}
                  loading="lazy"
                  class="aspect-[16/9] w-full object-cover"
                />
                <span class="flex flex-1 flex-col p-6">
                  <span class="inline-flex items-center gap-1.5 text-2xs font-semibold tracking-wide text-brand-700 uppercase">
                    <Icon name="book" size={14} />
                    Guide
                  </span>
                  <h3 class="mt-3 text-lg font-semibold text-ink-950 group-hover:text-brand-700">{guide.data.title}</h3>
                  <p class="mt-2.5 flex-1 text-[0.95rem] leading-relaxed text-ink-600">{guide.data.excerpt ?? guide.data.description}</p>
                  <span class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-2xs text-ink-400">
                    <span>Posted {shortDate(guide.data.published ?? guide.data.updated)}</span>
                    <span aria-hidden="true" class="text-ink-300">&middot;</span>
                    <span>Updated {shortDate(guide.data.updated)}</span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-5">
          <a href="/guides/" class="text-brand-700 text-sm font-semibold underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">
            Browse the full guide library
          </a>
        </div>
      </Section>
    )}

    <!-- Markets -->
    <Section
      id="markets"
      title="Markets we cover in depth"
      lede="We only publish a city page when we can say something specific about its fuel mix, its program and its contractor market. No templated city grid."
      class="reveal-on-scroll"
    >
      <ul class="grid gap-5 sm:grid-cols-2">
        {marketCards.map((card) => (
          <li>
            <MarketCard
              name={card.name}
              href={card.href}
              state={STATE_BY_CODE[card.code]}
              summary={card.summary}
            />
          </li>
        ))}
      </ul>
    </Section>

    <!-- Programs -->
    <Section
      id="programs"
      title="Heat pump rebates we track"
      lede="A short list, verified program by program, instead of a scraped database of every incentive in the country. If a program is reserved or funded out, we say so."
      class="reveal-on-scroll"
    >
      <ul class="flex flex-wrap gap-2.5">
        {[
          { name: 'Mass Save heat pump rebate', href: '/rebates/mass-save/' },
          { name: 'Efficiency Maine heat pump rebate', href: '/rebates/efficiency-maine/' },
          { name: 'NYSERDA heat pump rebate', href: '/rebates/nys-clean-heat/' },
          { name: 'Efficiency Vermont heat pump rebate', href: '/rebates/efficiency-vermont/' },
          { name: 'Energize CT heat pump rebate', href: '/rebates/energize-ct/' },
          { name: 'Xcel Energy heat pump rebate', href: '/rebates/xcel-energy/' },
          { name: 'Eversource heat pump rebate', href: '/rebates/eversource/' },
          { name: 'Heat pump tax credit', href: '/heat-pump-tax-credit/' },
          { name: 'Heat pump rebates', href: '/rebates/' },
        ].map((p) => (
          <li>
            <a
              href={p.href}
              class="inline-flex items-center rounded-full bg-white px-4 py-2 text-sm font-medium text-ink-700 ring-1 ring-line-strong transition-colors hover:bg-brand-50 hover:text-brand-800 hover:ring-brand-300"
            >
              {p.name}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm text-ink-500">
        Priority states: {priorityStates.map((s) => s.name).join(', ')}.
      </p>
    </Section>

    <Faq items={homeFaqs} />
    <KeywordCluster path={path} />
    <QuoteCta />
  </div>
</BaseLayout>
